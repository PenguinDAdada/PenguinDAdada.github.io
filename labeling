}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#141917; --surface:#1e2522; --ink:#e8ede9; --muted:#9aa6a0; --line:#344039;
  --accent:#6fc2ba; --accent-ink:#0f1a18; --warn:#e0a35c;
