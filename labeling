 "acc": "Hirosaki_City", "dt": "2022-08-12 16:36", "tx": "８月12日　16時07分 洪水警報が解除され、注意報となりました。  大雨警報（土砂災害）と土砂災害警戒情報は発令されたままですので、引き続き今後の気象情報に十分ご留意ください。"}, {"n": 186, "id": "1554838429317230593", "acc": "bousai_nanyo", "dt": "2022-08-03 23:35", "tx": "【大雨による通行止め区間のお知らせ】 市道上町線が路肩欠所により現在通行止めとなっています。 https://t.co/gl8zmE6ZH6"}, {"n": 187, "id": "1554859113515196416", "acc": "bousai_nanyo", "dt": "2022-08-04 00:57", "tx": "8月４日午前０時４０分に市内の停電は全て復旧しました。"}, {"n": 188, "id": "1554708887873650688", "acc": "Hirosaki_City", "dt": "2022-08-03 15:00", "tx": "12:30に平川の浸水想定区域に対し、警戒レベル４「避難指示」を発令しました。 平川の浸水想定区域にお住まいの方は、安全な親戚・知人宅等に避難してください。 岩木川の浸水想定区域に対して、発令した警戒レベル３「高齢者等避難」は解除しました。 ■問い合わせ先　防災課（☎0172-40-7100）"}, {"n": 189, "id": "1554338520789319683", "acc": "Hirosaki_City", "dt": "2022-08-02 14:29", "tx": "【大学生ボランティアによる学習支援】「あっぷる～む」の参加者を募集  経済的理由などで学習塾に通うことが困難な中学生などを対象とした学習支援教室です。  ▽とき　毎週水曜日の午後４時45分～６時35分 ▽ところ　文京地区 ▽参加料　無料 ※事前申込制。  詳細はこちら https://t.co/Jh9UiXTncs https://t.co/jLtDtB1Nri"}]</script>
<script>
(function(){
var LABELS=[
 {k:'警戒・注意喚起',c:'w',d:'まだ被害は出ていないが、危険性を予告・注意喚起する',e:'「大雨警報が発表されました」「河川の水位が上昇中」'},
 {k:'避難情報',c:'e',d:'避難に関する具体的な指示・情報',e:'「〇〇地区に避難指示が出ました」「避難所を開設しました」'},
 {k:'被害報告',c:'d',d:'実際に発生した被害の事実の報告',e:'「〇〇で床上浸水が発生」「橋が崩落しました」'},
 {k:'対応・復旧情報',c:'r',d:'行政の対応状況、復旧・支援の進捗',e:'「給水車を配置しました」「断水は復旧しました」'},
 {k:'未分類',c:'u',d:'上記のいずれにも当てはまらない(災害と無関係な投稿を含む)',e:'コロナ感染者数、イベント告知、クマ目撃情報'}
];
var BOUND=[
 '通行止め・交通規制の告知は「被害報告」か「対応・復旧情報」か',
 '避難指示の解除・避難所の閉鎖は「避難情報」か「対応・復旧情報」か',
 '防災アプリ・防災ポータルの案内は「警戒・注意喚起」か「未分類」か'
];
var ITEMS=JSON.parse(document.getElementById('data').textContent);
var KEY='tweet-labeler-v1';
var S={ann:'',ans:{},cur:0,view:'work',onlyOpen:false};
var main=document.getElementById('main');

function load(){try{var r=localStorage.getItem(KEY);if(r){var o=JSON.parse(r);if(o&&o.ans){S.ann=o.ann||'';S.ans=o.ans;S.cur=Math.min(o.cur||0,ITEMS.length-1);}}}catch(e){}}
var saveOK=true;
function save(){try{localStorage.setItem(KEY,JSON.stringify({ann:S.ann,ans:S.ans,cur:S.cur}));saveOK=true}catch(e){saveOK=false}}
function toast(m){var t=document.getElementById('toast');t.textContent=m;t.hidden=false;clearTimeout(toast.t);toast.t=setTimeout(function(){t.hidden=true},2200)}
function esc(s){return String(s).replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]})}
function linkify(s){return esc(s).replace(/(https?:\/\/[^\s<]+)/g,'<a href="$1" target="_blank" rel="noopener">$1</a>')}
function col(k){for(var i=0;i<LABELS.length;i++)if(LABELS[i].k===k)return 'var(--c-'+LABELS[i].c+')';return 'var(--line)'}
function doneCount(){var n=0;ITEMS.forEach(function(it){if(S.ans[it.id]&&S.ans[it.id].l)n++});return n}
function head(){var n=doneCount();document.getElementById('count').textContent=(S.cur+1)+' / '+ITEMS.length+'  済 '+n;
  document.getElementById('bar').style.width=(n/ITEMS.length*100)+'%'}
function nextOpen(from){for(var i=1;i<=ITEMS.length;i++){var j=(from+i)%ITEMS.length;if(!(S.ans[ITEMS[j].id]&&S.ans[ITEMS[j].id].l))return j}return -1}

function setLabel(k){var it=ITEMS[S.cur],a=S.ans[it.id]||{};a.l=k;a.t=new Date().toISOString();S.ans[it.id]=a;
  if(S.cur<ITEMS.length-1)S.cur++;else toast('最後の1件です');save();render()}
function go(i){S.cur=Math.max(0,Math.min(ITEMS.length-1,i));save();render()}

function viewWork(){
  var it=ITEMS[S.cur],a=S.ans[it.id]||{};
  var h='<div class="card"><div class="meta"><span>No.'+it.n+'</span><span>'+esc(it.acc)+'</span><span>'+esc(it.dt)+'</span></div>'+
   '<p class="text">'+linkify(it.tx)+'</p></div><div class="labels">';
  LABELS.forEach(function(L,i){h+='<button class="lab" style="--cc:var(--c-'+L.c+')" data-l="'+L.k+'" aria-pressed="'+(a.l===L.k)+'"><span class="k">'+(i+1)+'</span><span class="dot"></span>'+L.k+'</button>'});
  h+='</div><label class="flag"><input type="checkbox" id="flag"'+(a.f?' checked':'')+'> 迷った(後で見直したい)</label>'+
   '<textarea id="memo" placeholder="メモ(任意)">'+esc(a.m||'')+'</textarea>'+
   '<div class="row"><button class="btn" id="prev"'+(S.cur===0?' disabled':'')+'>← 前へ</button>'+
   '<button class="btn" id="next"'+(S.cur===ITEMS.length-1?' disabled':'')+'>次へ →</button>'+
   '<button class="btn primary" id="open">未回答へ</button></div>'+
   (a.l?'<div class="row"><button class="btn sm" id="clear">この回答を消す</button></div>':'');
  main.innerHTML=h;
  main.querySelectorAll('.lab').forEach(function(b){b.onclick=function(){setLabel(b.dataset.l)}});
  document.getElementById('prev').onclick=function(){go(S.cur-1)};
  document.getElementById('next').onclick=function(){go(S.cur+1)};
  document.getElementById('open').onclick=function(){var j=nextOpen(S.cur);if(j<0)toast('全件に回答済みです');else go(j)};
  var c=document.getElementById('clear');if(c)c.onclick=function(){var x=S.ans[it.id];if(x){x.l='';}save();render()};
  document.getElementById('flag').onchange=function(e){var x=S.ans[it.id]||{};x.f=e.target.checked;S.ans[it.id]=x;save()};
  document.getElementById('memo').oninput=function(e){var x=S.ans[it.id]||{};x.m=e.target.value;S.ans[it.id]=x;save()};
  main.scrollTop=0;
}
function viewList(){
  var h='<h2>一覧</h2><div class="legend">';
  LABELS.forEach(function(L){h+='<span style="--cc:var(--c-'+L.c+')">'+L.k+'</span>'});
  h+='<span>未回答</span><span style="--cc:var(--warn)">? 迷った</span></div><div class="grid">';
  ITEMS.forEach(function(it,i){var a=S.ans[it.id]||{};var d=a.l?'done':'';
    h+='<button class="cell'+(i===S.cur?' cur':'')+'" data-i="'+i+'" data-s="'+d+'" data-f="'+(a.f?1:0)+'" style="--cc:'+col(a.l)+'" aria-label="'+it.n+'番 '+(a.l||'未回答')+'">'+it.n+'</button>'});
  main.innerHTML=h+'</div>';
  main.querySelectorAll('.cell').forEach(function(b){b.onclick=function(){S.view='work';go(+b.dataset.i)}});
}
function viewDef(){
  var h='<h2>ラベルの定義</h2>';
  LABELS.forEach(function(L){h+='<div class="card def" style="--cc:var(--c-'+L.c+')"><h3>'+L.k+'</h3><p>'+L.d+'</p><p class="ex">例: '+L.e+'</p></div>'});
  h+='<h2>境界ケースの扱い</h2><p class="note">作業前に決めた方針を、ここに反映します。</p>';
  BOUND.forEach(function(b,i){h+='<div class="card def" style="--cc:var(--warn)"><h3>'+(i+1)+'</h3><p class="ex">'+b+'</p><p class="pending">(未決定)</p></div>'});
  main.innerHTML=h;
}
function counts(){var c={};LABELS.forEach(function(L){c[L.k]=0});var f=0;ITEMS.forEach(function(it){var a=S.ans[it.id];if(a&&a.l)c[a.l]++;if(a&&a.f)f++});return {c:c,f:f}}
function tsv(){
  var rows=['tweet_id\tlabel\tflag_unsure\tmemo\tannotator\tlabeled_at'];
  ITEMS.forEach(function(it){var a=S.ans[it.id]||{};
    if(!a.l&&!a.f&&!a.m)return;
    rows.push([it.id,a.l||'',a.f?1:0,(a.m||'').replace(/[\t\r\n]+/g,' '),S.ann,a.t||''].join('\t'))});
  return rows.join('\n');
}
function viewOut(){
  var k=counts();
  var h='<h2>保存と引き継ぎ</h2><div class="card"><label for="ann"><b>アノテーター名</b></label><input type="text" id="ann" placeholder="例: A" value="'+esc(S.ann)+'">'+
  '<div class="stat"><span>回答済み</span><span>'+doneCount()+' / '+ITEMS.length+'</span>';
  LABELS.forEach(function(L){h+='<span>'+L.k+'</span><span>'+k.c[L.k]+'</span>'});
  h+='<span>迷った</span><span>'+k.f+'</span></div></div>'+
  '<div class="row"><button class="btn primary" id="copy">回答をコピー(TSV)</button></div>'+
  '<p class="note">コピーしたら、メモ帳やメールの本文に貼り付けて送ってください。tweet_id は文字列のまま入っています。Excel に貼るときは tweet_id 列を「文字列」にしてください。</p>'+
  '<textarea id="tsv" readonly style="min-height:120px;font-family:var(--f-mono);font-size:12px">'+esc(tsv())+'</textarea>'+
  '<hr class="sep"><h2>途中から再開・別の端末へ</h2><p class="note">コピーしたTSVを下に貼って「読み込む」を押すと、回答が復元されます。</p>'+
  '<textarea id="imp" placeholder="ここにTSVを貼り付け" style="min-height:90px"></textarea>'+
  '<div class="row"><button class="btn" id="doimp">読み込む</button></div>'+
  '<hr class="sep"><div class="row"><button class="btn sm" id="reset">全回答を消す</button></div><div id="rc"></div>'+
  (saveOK?'':'<p class="note pending">この環境ではブラウザ内に自動保存できません。作業の区切りごとに「回答をコピー」で控えを取ってください。</p>')+
  '<p class="note">回答はこの端末のブラウザ内に自動保存されます。</p>';
  main.innerHTML=h;
  document.getElementById('ann').oninput=function(e){S.ann=e.target.value;save()};
  document.getElementById('copy').onclick=function(){var t=tsv();var ta=document.getElementById('tsv');ta.value=t;
    function fb(){ta.focus();ta.select();toast('選択しました。長押しでコピーしてください')}
    if(navigator.clipboard&&navigator.clipboard.writeText)navigator.clipboard.writeText(t).then(function(){toast('コピーしました')},fb);else fb()};
  document.getElementById('doimp').onclick=function(){
    var lines=document.getElementById('imp').value.split(/\r?\n/).filter(function(x){return x.trim()});
    var ids={};ITEMS.forEach(function(it){ids[it.id]=1});var n=0;
    lines.forEach(function(ln,i){var p=ln.split('\t');if(i===0&&p[0]==='tweet_id')return;
      if(!ids[p[0]])return;var lab=p[1]||'';if(lab&&!LABELS.some(function(L){return L.k===lab}))return;
      S.ans[p[0]]={l:lab,f:p[2]==='1',m:p[3]||'',t:p[5]||''};if(p[4]&&!S.ann)S.ann=p[4];n++});
    save();toast(n+'件を読み込みました');render()};
  document.getElementById('reset').onclick=function(){
    var rc=document.getElementById('rc');rc.innerHTML='<p class="pending">本当にすべての回答を消しますか?</p><div class="row"><button class="btn sm" id="yes">消す</button><button class="btn sm" id="no">やめる</button></div>';
    document.getElementById('yes').onclick=function(){S.ans={};S.cur=0;save();toast('消しました');render()};
    document.getElementById('no').onclick=function(){rc.innerHTML=''}};
}
function render(){
  head();
  document.querySelectorAll('nav button').forEach(function(b){b.setAttribute('aria-selected',b.dataset.v===S.view)});
  if(S.view==='work')viewWork();else if(S.view==='list')viewList();else if(S.view==='def')viewDef();else viewOut();
}
document.querySelectorAll('nav button').forEach(function(b){b.onclick=function(){S.view=b.dataset.v;render()}});
document.addEventListener('keydown',function(e){
  if(S.view!=='work'||/INPUT|TEXTAREA/.test((e.target||{}).tagName||''))return;
  if(e.key>='1'&&e.key<='5')setLabel(LABELS[+e.key-1].k);
  else if(e.key==='ArrowLeft')go(S.cur-1);else if(e.key==='ArrowRight')go(S.cur+1)});
load();render();
})();
</script>

</body>
